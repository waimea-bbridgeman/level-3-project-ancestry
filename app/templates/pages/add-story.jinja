{#=====================================================
Add Story Page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{# Tag a person to a story #}
{% block content %}

<div class="storyform">
   <h1>Post a new story!</h1>

   <form method="post" action="/story/new">
      <h3>New Story</h3>

      <label>
         Title
         <input name="title" type="text" placeholder="e.g. Rodney meets Trig " required>
      </label>


      <label>
         Date
         <input name="date" type="date" placeholder="date" required>
      </label>

      <label>
         Body
         <textarea name="body" placeholder="e.g. Trig called Rodney Dave" required></textarea>
      </label>

      <details>
         <summary>Who is in this story?</summary>

         {% for person in people %}
         <label>
            <input name="people" value="{{ person.id }}" type="checkbox">
            {{ person.forename }} {{ person.surname }}
         </label>
         {% else %}
         <p>No people yet. <a href="/people/new">Add someone first</a>.</p>
         {% endfor %}
      </details>


      

      <button>Add Story</button>
      <button><a href="/stories">Cancel</a></button>
   </form>
</div>

{% endblock %}