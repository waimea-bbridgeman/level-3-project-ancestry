{% extends "pages/_base.jinja" %}

{% block title %}
    Login
{% endblock %}

{% block content %}
   
  <h2>Login</h2>

  <form method="post" action="/login" id="login">
    <label>
        Username
        <input name="username" type="text" required>
    </label>

    <label>
        Password
        <input name="password" type="password" required>
    </label>

    <button>Login</button> 

  </form>

  <p>If you don't have an account, <a href="/user/new">signup here</a></p>
{% endblock %}