{#=====================================================
  Story display page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>The {{ session.family.surname }} Family</h2>

    
    <button id="story-button"><a href="/story">Add Story</a></button>

    <h2>{{ title }}</h2>
    

    <section id="stories">

        {% for story in stories %}
      
            <div class="stories">

                <header>
                    <h3><a href="/story/{{ story.id }}">{{ story.title }}</a></h3>                   
                </header>

                <p>{{ story.body }}</p>

                {% for person in tagged %}
                    {% if person.story_id == story.id %}
                        Involves: <span class="tag">{{ person.forename }} {{ person.surname }}</span>
                    {% endif %}
                {% endfor %}
                
                <footer>
                    Date: {{ story.date }}
                </footer>

            </div>

        {% else %}

            <p>No Stories!</p>

        {% endfor %}

        

    </section>

{% endblock %}

