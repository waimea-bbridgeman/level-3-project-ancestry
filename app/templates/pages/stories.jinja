{#=====================================================
  Story display page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>The {{ session.family.surname }} Family</h2>

    {# OTHER DETAILS HERE #}
    
    <h3>Stories</h3>
    
    <button id="story-button"><a href="/story">Add Story</a></button>

    <section id="stories">

        {% for story in stories %}
      
            <div class="stories">

                <header>
                    <h3>{{ story.title }}</h3>
                   
                </header>

                <p>{{ story.body }}</p>

                <footer>
                    Date: {{ story.date }}
                </footer>

            </div>

        {% else %}

            <p>No Stories!</p>

        {% endfor %}

        

    </section>

{% endblock %}

