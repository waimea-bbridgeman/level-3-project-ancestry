{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="dark">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Ancestry Tracker {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>

        <nav>
        {% if session.logged_in %}
            Welcome, {{ session.user.forename }}!
        <a href="/">Home</a>
        <a href="/logout">Logout</a>
        <a href="/stories">Stories</a>
        {% else %}
            <a href="/">Home</a>
            <a href="/login">Login</a>
            <a href="/user/new">Sign-Up</a>
        {% endif %} 
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>

