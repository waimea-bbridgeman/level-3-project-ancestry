{#=====================================================
All People
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<h2>All People</h2>

<section id="people">

    {% for person in people %}
    <a class="card" href="/person/{{ person.id }}">
        {% if person.image %}
        <img class="thumb" src="/static/images/{{ person.image }}" alt="">
        {% endif %}
        <h3>{{ person.forename }} {{ person.surname }}</h3>
    </a>
    {% endfor %}

</section>

{% endblock %}