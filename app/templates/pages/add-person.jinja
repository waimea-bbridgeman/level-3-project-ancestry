{% extends "pages/_base.jinja" %}

{% block title %}
    Add Person
{% endblock %}

{% block content %}

    <h2>Add a person</h2>

    <form method="post" action="/person" enctype="multipart/form-data">

        <label>
            Forename
            <input type="text" name="forename">
        </label>

        <label>
            Surname
            <input type="text" name="surname">
        </label>

        <label>
            Notes
            <textarea name="notes"></textarea>
        </label>

        <label>
            Date of Birth
            <input type="date" name="dob">
        </label>

        <label>
            Cover image
            <input type="file" name="image" accept="image/png, image/jpeg, image/gif, image/webp">
        </label>

        <label>
            Social media links
            <textarea name="links" placeholder="One link per line"></textarea>
        </label>

        <button>Add</button>
        <button><a class="button" href="/all-people.jinja">Cancel</a></button>

    </form>

{% endblock %}