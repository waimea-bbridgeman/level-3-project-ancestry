{#=====================================================
Pick page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<h2>Pick which family</h2>

<section id="families">
  {% for family in families %}

  <div class="family-pick">
    <a href="/fam/{{ family.id }}" class="card">
      <h3>{{ family.surname }}</h3>
    </a>
  </div>

  {% endfor %}
</section>

{% endblock %}